{
  // Demo deploy on workers.dev. Deploy with: npm run deploy:demo
  // No credential is issued for this demo, so the API answers 401. The page loads and shows no data.
  // The web UI is served from ui-dist.
  "name": "agentic-tables-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "send_metrics": false,
  "workers_dev": true,
  "assets": { "directory": "./ui-dist", "run_worker_first": ["/api/*", "/health"] },
  // Created with: wrangler d1 create agentic-tables-demo --location weur
  "d1_databases": [{ "binding": "DB", "database_name": "agentic-tables-demo", "database_id": "37762f27-095a-498e-8049-d6e6b01d843a" }],
  "vars": { "AGENTIC_TABLES_REGION": "eu" }
}
