{
  // Worker for the /api/v1/tables HTTP API. Data lives in D1, so it survives restarts
  // and every Worker instance sees the same data.
  "name": "agentic-tables",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "send_metrics": false,
  // The root of agentic-identity imports node:module for its version string.
  "compatibility_flags": ["nodejs_compat"],
  // Create the database in the EU, then put its id below:
  //   wrangler d1 create agentic-tables --location weur
  // Local `wrangler dev` keeps its own copy and ignores the id.
  "d1_databases": [{ "binding": "DB", "database_name": "agentic-tables", "database_id": "00000000-0000-0000-0000-000000000000" }]
  // Set AGENTIC_TABLES_REGION ("eu" or "us") for each deploy, for example with --var. It is the region
  // the database lives in. D1 cannot report it, so it is a claim you make, and no default is set here.
}
