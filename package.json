{
  "name": "agentic-tables",
  "version": "0.4.0",
  "description": "Typed tables that agents read and write as rows.",
  "keywords": [
    "database",
    "tables",
    "airtable",
    "rows",
    "schema",
    "agents",
    "mcp",
    "cli",
    "structured-data"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-tables.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "llms.txt",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-tables",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./file-store": {
      "types": "./dist/store-file.d.ts",
      "import": "./dist/store-file.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "ci:local": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-identity": "^0.4.0",
    "hono": "^4.13.14",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  },
  "bin": {
    "agentic-tables": "./dist/cli.js",
    "agentic-tables-mcp": "./dist/mcp-bin.js"
  }
}
